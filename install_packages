---

- hosts: all 
  become: true
  pre_tasks:
  
  - name: update (RedHat)
    tags: always 
    dnf:
      update_only: yes
      update_cache: yes
    when: ansible_distribution == "RedHat"


  - name: update (Ubuntu)
    apt:
      upgrade: dist 
      update_cache: yes
    when: ansible_distribution == "Ubuntu"


- hosts: all
  become: true 
  tasks:
  
  - name: create simone user
    tags: always 
    user:
      name: simone
      groups: root

  - name: ssh key for simone
    tags: always
    authorized_key:
      user: simone
      key:ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGrJPWP/8bWbJUD/fMl/RtRtTsowELq8q4Ykx3hxIwsZ ansible

  - name: add sudoers for simone
    tags: always
    copy:
      src: sudoer_simone
      dest: /etc/sudoers.d/simone
      owner: root
      group: root 
      mode: 0440 


- hosts: web_servers
  become: true
  tasks: 

  - name: httpd install
    tags: web 
    package:
      name:
        - httpd
    when: ansible_distribution == "RedHat"


  - name: default_site.html
    tags: site
    copy:
      src: default_site.html
      dest: /var/www/html/index.html
      owner: root
      group: root 
      mode: 0644


  - name: ServerAdmin
    tags: lineinfile
    lineinfile:
      path: /etc/httpd/conf/httpd.conf
      regexp: '^ServerAdmin'
      line: ServerAdmin rhuseynli@Server1
    when: ansible_distribution == "RedHat"
    register: httpd 


- hosts: workstations
  become: true
  tasks:
  
  - name: install terraform
    tags: terraform
    unarchive: 
      src: https://releases.hashicorp.com/terraform/0.12.28/terraform_0.12.28_linux_amd64.zip
      dest: /usr/local/bin
      owner: root
      group: root
      mode: 0644
      remote_src: yes 
    when: ansible_distribution == "RedHat"
    


- hosts: db_servers   
  become: true
  tasks:
    
  - name: install mariadb for RedHat
    tags: Rmariadb
    dnf:
      name: mariadb 
      state: latest
    when: ansible_distribution == "RedHat"


  - name: mariadb for Ubuntu
    tags: Umariadb 
    apt:
      name: mariadb-server
      state: latest
    when: ansible_distribution == "Ubuntu"

- hosts: file_servers
  become: true
  tasks:

  - name: install samba for "RedHat" and "Ubuntu
    tags: Samba
    package:
      name: samba
    when: ansible_distribution in ["RedHat", "Ubuntu"]











