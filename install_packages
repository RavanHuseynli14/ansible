---

- hosts: all 
  become: true
  pre_tasks:
  
  - name: update (RedHat)
    tags: always 
    dnf:
      update_only: yes
      update_cache: yes
    when: ansible_distribution == "RedHat"


  - name: update (Ubuntu)
    apt:
      upgrade: dist 
      update_cache: yes
    when: ansible_distribution == "Ubuntu"


- hosts: all
  become: true 
  tasks:
  
  - name: create simone user
    tags: always 
    user:
      name: simone
      groups: root

  - name: ssh key for simone
    tags: always
    authorized_key:
      user: simone
      key: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGrJPWP/8bWbJUD/fMl/RtRtTsowELq8q4Ykx3hxIwsZ ansible

  - name: add sudoers for simone
    tags: always
    copy:
      src: sudoer_simone
      dest: /etc/sudoers.d/simone
      owner: root
      group: root 
      mode: 0440

- hosts: workstations
  become: true
  roles:
    - workstations


- hosts: db_servers
  become: true
  roles:
    - db_servers


- hosts: web_servers
  become: true
  roles:
    - web_servers 
  notify: httpd 
